# Local staging profile. Copy to .env.staging and run ./scripts/staging.ps1.
# This is a production-like rehearsal on one workstation, not a cloud environment.
# Ports are offset by +1000 (+100 for PostgreSQL) so it can run beside the dev stack.

# Compose
COMPOSE_PROJECT_NAME=neatsprint-staging

# Gateway
GATEWAY_HTTP_PORT=8100
GATEWAY_DASHBOARD_PORT=8189

# PostgreSQL
POSTGRES_USER=neatsprint
POSTGRES_PASSWORD=neatsprint-staging-only
POSTGRES_DB=neatsprint
POSTGRES_PORT=5532

# Redis
REDIS_PORT=6479

# MinIO
MINIO_ROOT_USER=neatsprint
MINIO_ROOT_PASSWORD=neatsprint-staging-secret
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_BUCKET=neatsprint

# Mailpit
MAILPIT_UI_PORT=8125
MAILPIT_SMTP_PORT=1125

# Web
WEB_PORT=3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100/api/v1
API_INTERNAL_URL=http://gateway/api/v1

# Optional Google sign-in (same value as the IAM GOOGLE_CLIENT_ID).
# Leave empty to hide the Google button; set it to enable sign-in on this stack.
GOOGLE_CLIENT_ID=

# Optional Cloudflare Turnstile secret
CAPTCHA_SECRET=

# Service host ports
IAM_PORT=8101
CORE_PORT=8102
TASK_PORT=8103
TEAM_PORT=8104
WORKLOG_PORT=8105
MONITORING_PORT=8106
CHAT_PORT=8107
REPORTS_PORT=8108
AI_PORT=8109

# Malware scanning is on in staging. CLAMAV_PORT is the in-network port;
# CLAMAV_HOST_PORT is only the host mapping.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_HOST_PORT=3410

# Observability profile
GRAFANA_PORT=3201
PROMETHEUS_PORT=9190

# Staging-only secrets. Replace before exposing this host to anyone else.
JWT_ISSUER=neatsprint-iam
JWT_AUDIENCE=neatsprint
BOOTSTRAP_TOKEN=staging-bootstrap-token-change-me
