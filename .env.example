# Copy to .env and adjust for your machine. Never commit .env.

# Compose
COMPOSE_PROJECT_NAME=neatsprint

# Gateway
GATEWAY_HTTP_PORT=8000
GATEWAY_DASHBOARD_PORT=8089

# PostgreSQL (single cluster, one logical database per service — ADR-002)
POSTGRES_USER=neatsprint
POSTGRES_PASSWORD=neatsprint
POSTGRES_DB=neatsprint
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=neatsprint
MINIO_ROOT_PASSWORD=neatsprint-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=neatsprint

# Mailpit (SMTP capture in development)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Server-side calls from the web container go through the gateway service name.
API_INTERNAL_URL=http://gateway/api/v1

# Optional Google sign-in (same value as the IAM GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Optional Cloudflare Turnstile secret. Leave empty until the web widget ships.
CAPTCHA_SECRET=

# Service host ports (direct access for debugging; the gateway is the normal entry)
IAM_PORT=8001
CORE_PORT=8002
TASK_PORT=8003
TEAM_PORT=8004
WORKLOG_PORT=8005
MONITORING_PORT=8006
CHAT_PORT=8007
# Optional malware scanner (docker compose --profile security up -d clamav)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_HOST_PORT=3310
REPORTS_PORT=8008
AI_PORT=8009

# Observability profile
GRAFANA_PORT=3001
# 9090 is often taken by other software (Tomcat, Prometheus); override if needed.
PROMETHEUS_PORT=9090

# Local development only. Generate real keys in M1.
JWT_ISSUER=neatsprint-iam
JWT_AUDIENCE=neatsprint

# Bootstrap token for local seeding. Never use this value outside development.
BOOTSTRAP_TOKEN=dev-bootstrap-token-change-me

GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com